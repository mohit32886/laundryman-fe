# Backend API base URL (no trailing slash)
VITE_API_URL=http://localhost:5001

# Must match server-side PUBLIC_API_KEY. Sent as X-Public-API-Key on public routes.
VITE_PUBLIC_API_KEY=

# Safe to expose. Must match server-side RAZORPAY_KEY_ID.
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxx

# Legacy: used only by getProductPrices() to hit the admin app's product API.
# Keep this pointing at the same backend for now.
VITE_ORDER_API_URL=http://localhost:5001

# Optional — Google Sheets Apps Script URL for legacy marketing forms.
# Kept only as a fallback: the primary path posts to /api/leads on the backend.
VITE_GOOGLE_SCRIPT_URL=

# Set to 'false' to force the Google Sheets path and bypass the backend lead endpoint.
VITE_LEAD_BACKEND_ENABLED=true
